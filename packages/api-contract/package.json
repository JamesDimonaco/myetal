{
  "name": "@myetal/api-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generated TypeScript contract for the MyEtAl FastAPI backend. Single source of truth for web + mobile. Do not hand-edit src/generated.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:stale": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
